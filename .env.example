# Copy to .env. This file is sourced by Bash; quote paths containing spaces.
YUE_HOST=127.0.0.1
YUE_PORT=7860
# Optional: absolute path to the Linux Codex executable (otherwise found on PATH).
# YUE_CODEX_BIN=/absolute/path/to/codex
# Optional: existing Codex settings directory; otherwise Codex uses its own default.
# CODEX_HOME=/absolute/path/to/codex-settings
# Optional: trusted LAN hostname/IP, comma separated; see docs/SETUP.md.
# YUE_ALLOWED_HOSTS=your-pc.local
# Optional: absolute storage directory for songs, albums and private YouTube state.
# YUE_DATA_DIR=/absolute/path/to/otoni-data
